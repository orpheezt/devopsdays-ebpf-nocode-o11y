# syntax=docker/dockerfile:1
FROM docker.io/bellsoft/liberica-runtime-container:jdk-25-stream-glibc AS builder

WORKDIR /build

RUN --mount=type=bind,source=build.gradle.kts,target=build.gradle.kts \
    --mount=type=bind,source=settings.gradle.kts,target=settings.gradle.kts \
    --mount=type=bind,source=gradle.properties,target=gradle.properties \
    --mount=type=bind,source=gradle,target=gradle \
    --mount=type=bind,source=gradlew,target=gradlew \
    --mount=type=bind,source=src,target=src \
    --mount=type=cache,target=/root/.gradle \
    sh ./gradlew quarkusBuild --no-daemon

FROM docker.io/bellsoft/liberica-runtime-container:jre-25-stream-glibc AS runtime

RUN apk add --no-cache ca-certificates tzdata

ARG UID=10001
ARG GID=10001
RUN addgroup -g ${GID} appgroup && \
    adduser -u ${UID} -G appgroup -D -s /sbin/nologin -h /app appuser

WORKDIR /app

COPY --from=builder --chown=appuser:appgroup /build/build/quarkus-app/lib/ /app/lib/
COPY --from=builder --chown=appuser:appgroup /build/build/quarkus-app/*.jar /app/
COPY --from=builder --chown=appuser:appgroup /build/build/quarkus-app/app/ /app/app/
COPY --from=builder --chown=appuser:appgroup /build/build/quarkus-app/quarkus/ /app/quarkus/

USER appuser

EXPOSE 8084

ENV PORT=8084 \
    JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Dquarkus.http.port=8084 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

ENTRYPOINT ["java", "-jar", "/app/quarkus-run.jar"]
